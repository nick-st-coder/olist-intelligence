# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

# --- Local Postgres (Phase 4) ---
POSTGRES_USER=olist
POSTGRES_PASSWORD=change_me
POSTGRES_DB=olist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- GCP (Phase 4+, optional) ---
GCP_PROJECT_ID=
GCS_BUCKET_RAW=
BQ_DATASET_RAW=raw
BQ_DATASET_STAGING=staging
BQ_DATASET_ANALYTICS=analytics
GOOGLE_APPLICATION_CREDENTIALS=

# --- MLflow (Phase 6+) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=olist-delivery-delay
MLFLOW_MODEL_NAME=olist-delivery-delay

# --- API (Phase 7+) ---
MODEL_PATH=models/olist_delivery_delay
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Project ---
PROJECT_ROOT=.
RANDOM_SEED=42
