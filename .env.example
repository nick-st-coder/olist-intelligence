# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

# --- Local Postgres (Phase 4) ---
POSTGRES_USER=olist
POSTGRES_PASSWORD=change_me
POSTGRES_DB=olist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- GCP (Phase 4+, optional) ---
GCP_PROJECT_ID=
GCS_BUCKET_RAW=
BQ_DATASET_RAW=raw
BQ_DATASET_STAGING=staging
BQ_DATASET_ANALYTICS=analytics
# Application Default Credentials, created by `gcloud auth application-default login`.
# A service-account keyfile is not used: the project enforces
# constraints/iam.disableServiceAccountKeyCreation.
# Windows: C:/Users/<you>/AppData/Roaming/gcloud/application_default_credentials.json
# Linux/macOS: ~/.config/gcloud/application_default_credentials.json
ADC_PATH=

# --- Orchestration ---
# "true" runs the GCS/BigQuery branch of the DAG in addition to the local Postgres path.
OLIST_CLOUD_ENABLED=false

# --- MLflow (Phase 6+) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=olist-delivery-delay
MLFLOW_MODEL_NAME=olist-delivery-delay

# --- Prediction service ---
# MODEL_PATH is informational: the artefact path comes from src.config, so the training step and
# the service cannot disagree about where it lives.
MODEL_PATH=models/olist_delivery_delay
API_HOST=0.0.0.0
API_PORT=8000
# Host ports used by docker compose. The container ports stay 8000 and 8501.
API_PORT_HOST=8000
STREAMLIT_PORT_HOST=8501
LOG_LEVEL=INFO
# The dashboard talks to the API over HTTP. Inside compose the service name resolves to the API.
API_URL=http://localhost:8000
API_TIMEOUT_SECONDS=30

# --- Project ---
PROJECT_ROOT=.
RANDOM_SEED=42
