table fact_orders
	lineageTag: 7a1b0001-0000-4000-8000-000000000001

	measure 'Total Orders' = COUNTROWS ( fact_orders )
		formatString: #,0
		lineageTag: 7a1b0002-0001-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Eligible Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_label_eligible] = TRUE )
		formatString: #,0
		lineageTag: 7a1b0002-0002-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Revenue' = SUM ( fact_orders[item_revenue] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7a1b0002-0003-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Freight' = SUM ( fact_orders[freight_value] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7a1b0002-0004-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Order Value' = DIVIDE ( [Total Revenue], [Total Orders] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7a1b0002-0005-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Freight Share of Revenue' = DIVIDE ( [Total Freight], [Total Revenue] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1b0002-0006-4000-8000-000000000001

	measure 'Late Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_late] = TRUE )
		formatString: #,0
		lineageTag: 7a1b0002-0007-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Rate %' = DIVIDE ( [Late Orders], [Eligible Orders] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1b0002-0008-4000-8000-000000000001

	measure 'Average Delivery Days' = CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[is_label_eligible] = TRUE )
		formatString: 0.00
		lineageTag: 7a1b0002-0009-4000-8000-000000000001

	measure 'Average Estimated Lead Days' = AVERAGE ( fact_orders[estimated_lead_days] )
		formatString: 0.00
		lineageTag: 7a1b0002-0010-4000-8000-000000000001

	measure 'Average Delay Days (late only)' = CALCULATE ( AVERAGE ( fact_orders[delay_days] ), fact_orders[is_late] = TRUE )
		formatString: 0.00
		lineageTag: 7a1b0002-0011-4000-8000-000000000001

	measure 'On Time Rate %' = 1 - [Late Rate %]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1b0002-0012-4000-8000-000000000001

	measure 'Unique Customers' = DISTINCTCOUNT ( fact_orders[customer_unique_id] )
		formatString: #,0
		lineageTag: 7a1b0002-0013-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Orders per Customer' = DIVIDE ( [Total Orders], [Unique Customers] )
		formatString: 0.000
		lineageTag: 7a1b0002-0014-4000-8000-000000000001

	measure 'Repeat Customers' =
			COUNTROWS (
			    FILTER (
			        VALUES ( fact_orders[customer_unique_id] ),
			        CALCULATE ( COUNTROWS ( fact_orders ) ) > 1
			    )
			)
		formatString: #,0
		lineageTag: 7a1b0002-0015-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Repeat Purchase Rate %' = DIVIDE ( [Repeat Customers], [Unique Customers] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1b0002-0016-4000-8000-000000000001

	measure 'Revenue per Customer' = DIVIDE ( [Total Revenue], [Unique Customers] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7a1b0002-0017-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Review Score' = AVERAGE ( fact_orders[review_score] )
		formatString: 0.000
		lineageTag: 7a1b0002-0018-4000-8000-000000000001

	measure 'Low Score Orders' =
			CALCULATE (
			    COUNTROWS ( fact_orders ),
			    fact_orders[review_score] <= 2,
			    NOT ISBLANK ( fact_orders[review_score] )
			)
		formatString: #,0
		lineageTag: 7a1b0002-0019-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Low Score Rate %' = DIVIDE ( [Low Score Orders], COUNTROWS ( fact_orders ) )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1b0002-0020-4000-8000-000000000001

	measure 'Revenue MoM %' =
			VAR Current = [Total Revenue]
			VAR Prior =
			    CALCULATE ( [Total Revenue], DATEADD ( dim_date[date_day], -1, MONTH ) )
			RETURN
			    DIVIDE ( Current - Prior, Prior )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1b0002-0021-4000-8000-000000000001

	measure 'Revenue YoY %' =
			VAR Current = [Total Revenue]
			VAR Prior =
			    CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( dim_date[date_day] ) )
			RETURN
			    DIVIDE ( Current - Prior, Prior )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1b0002-0022-4000-8000-000000000001

	measure 'Revenue 3M Rolling' =
			CALCULATE (
			    [Total Revenue],
			    DATESINPERIOD ( dim_date[date_day], MAX ( dim_date[date_day] ), -3, MONTH )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7a1b0002-0023-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Rate 3M Rolling' =
			CALCULATE (
			    [Late Rate %],
			    DATESINPERIOD ( dim_date[date_day], MAX ( dim_date[date_day] ), -3, MONTH )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1b0002-0024-4000-8000-000000000001

