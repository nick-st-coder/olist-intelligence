table fact_order_items
	lineageTag: 7a1b0003-0000-4000-8000-000000000001

	measure 'Category Revenue' = SUM ( fact_order_items[price] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7a1b0004-0001-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Category Revenue Share %' =
			DIVIDE (
			    [Category Revenue],
			    CALCULATE ( [Category Revenue], ALL ( dim_products[product_category] ) )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1b0004-0002-4000-8000-000000000001

	measure 'Category Late Rate %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_order_items ), fact_order_items[is_late] = TRUE ),
			    CALCULATE ( COUNTROWS ( fact_order_items ), fact_order_items[is_label_eligible] = TRUE )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a1b0004-0003-4000-8000-000000000001

	measure 'Category Freight' = SUM ( fact_order_items[freight_value] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7a1b0004-0004-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Category Items' = COUNTROWS ( fact_order_items )
		formatString: #,0
		lineageTag: 7a1b0004-0005-4000-8000-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

