model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["AnalyticsSchema","fact_orders","fact_order_items","dim_customers","dim_products","dim_sellers","dim_date"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table dim_customers
ref table dim_date
ref table dim_products
ref table dim_sellers
ref table fact_orders
ref table fact_order_items

