# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Data — raw CSVs are the read-only source of truth and are never versioned.
# Derived artefacts are also excluded; only the .gitkeep placeholders are tracked.
data/*.csv
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep

# Secrets
.env
.env.*
!.env.example
*.pem
*.json.key
service-account*.json

# ML artifacts
mlruns/
mlartifacts/
models/
*.pkl
*.joblib
*.onnx
mlflow.db
mlflow.db-journal

# dbt
dbt/target/
dbt/dags/
dbt/logs/
dbt/profiles.yml
dbt/.user.yml
dbt/dbt_packages/
!dbt/models/

# Local agent notes and project context — personal working documents, never committed
MEMORY.md
FUTURE.md
CONTEXT.md

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json

# Power BI — user- and machine-specific state, never committed
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf
powerbi/**/.pbi/unappliedChanges.json
powerbi/**/diagramLayout.json
powerbi/**/semanticModelDiagramLayout.json
powerbi/**/mobileState.json

# Local tooling (TMDL validator, AS query helper) — build output only
.tools/
tools/**/bin/
tools/**/obj/

#Github
.github/agents/
.github/instructions/
.github/prompts/