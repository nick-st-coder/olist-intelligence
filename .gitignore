# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Data — raw CSVs are the read-only source of truth and are never versioned.
# Derived artefacts are also excluded; only the .gitkeep placeholders are tracked.
data/*.csv
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep

# Secrets
.env
.env.*
!.env.example
*.pem
*.json.key
service-account*.json

# ML artifacts
mlruns/
mlartifacts/
models/
*.pkl
*.joblib
*.onnx

# dbt
dbt/target/
dbt/dags/
dbt/logs/
dbt/profiles.yml

# Local agent notes and project context — personal working documents, never committed
MEMORY.md
FUTURE.md
CONTEXT.md

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json

#Github
.github/agents/
.github/instructions/
.github/prompts/